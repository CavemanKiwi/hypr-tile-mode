# tile-mode for a classic hyprland.conf. Add these lines to ~/.config/hypr/hyprland.conf.
# First run once:  mkdir -p ~/.local/state/tile-mode && touch ~/.local/state/tile-mode/rules.conf

# Keep split widths applied as windows open.
exec-once = tile-mode watch

# Keep the T-3/T-4 main window centred from two windows up (the default waits for three).
master {
    slave_count_for_center_master = 0
}

# One keypress per layout: T-1 default, T-2 2/3 | 1/3, T-3 1/3 | 1/3 | 1/3, T-4 1/5 | 3/5 | 1/5.
bind = SUPER ALT, 1, exec, tile-mode 1
bind = SUPER ALT, 2, exec, tile-mode 2
bind = SUPER ALT, 3, exec, tile-mode 3
bind = SUPER ALT, 4, exec, tile-mode 4

# Saved per-workspace rules. Keep this as the last line, so they win over earlier workspace rules.
source = ~/.local/state/tile-mode/rules.conf
